{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wisher.app/wishlist.schema.json",
  "title": "Wisher Wishlist Document",
  "description": "Canonical schema for Wisher wishlist import/export documents. Kept in sync with src/lib/importSchema.ts (Zod is the runtime validator). Images are stored inline as base64 data URLs.",
  "type": "object",
  "required": ["schemaVersion", "lists"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Version of this schema. Must be 1."
    },
    "lists": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/wishlist"
      }
    }
  },
  "definitions": {
    "wishlist": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Wishlist title."
        },
        "description": {
          "type": "string",
          "description": "Optional wishlist description."
        },
        "eventDate": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional event date as a Unix timestamp (milliseconds), non-negative."
        },
        "ordered": {
          "type": "boolean",
          "description": "Whether this is a manually-ordered list."
        },
        "items": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/definitions/item"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Item name."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://.+",
          "description": "Optional product URL (http/https only)."
        },
        "priceMinor": {
          "type": "integer",
          "minimum": 0,
          "description": "Price in minor currency units (e.g. cents)."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Za-z]{3}$",
          "default": "USD",
          "description": "ISO 4217 currency code, defaults to USD."
        },
        "image": {
          "type": "string",
          "description": "Optional image as a base64 data URL (data:image/...;base64,...)."
        },
        "notes": {
          "type": "string",
          "description": "Optional free-form notes."
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "description": "Manual order position, used for ordered lists."
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "default": "medium",
          "description": "Item priority, defaults to medium."
        },
        "purchased": {
          "type": "boolean",
          "default": false,
          "description": "Whether the item has been purchased."
        }
      }
    }
  }
}
