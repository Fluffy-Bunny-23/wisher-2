{
  "name": "wisher",
  "version": "1.0.0",
  "private": true,
  "description": "Wisher — multi-user wishlist web app",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:e2e": "playwright test",
    "ci:fast": "concurrently --kill-others-on-fail -n lint,typecheck,unit,convex -c red,blue,green,yellow \"pnpm lint\" \"pnpm typecheck\" \"pnpm test:unit\" \"pnpm test:convex\"",
    "ci": "pnpm ci:fast && pnpm test:e2e"
  },
  "dependencies": {
    "convex": "^1.19.0",
    "firebase": "^10.14.0",
    "next": "14.2.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "convex-test": "^0.0.55",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^2.1.0"
  }
}
